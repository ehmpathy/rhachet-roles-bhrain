// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`asPartitionFaultSection given: [case1] a transient fault when: [t0] the section renders then: it matches snapshot 1`] = `
"# blocker.1 — this partition did not review

💥 MalfunctionError: the partition failed before it returned a verdict: the brain call failed — terminated

an unread verdict cannot be assumed clean, so it counts as one blocker.
every other partition kept its verdict above and below. the fault is transient, so
re-arrive to re-run this lane."
`;

exports[`asPartitionFaultSection given: [case2] one partition of two refuses on an overflow when: [t0] the section renders then: it matches snapshot 1`] = `
"# blocker.1 — this partition did not review

✋ ConstraintError: the partition failed before it returned a verdict: prompt exceeds 75% of context window

an unread verdict cannot be assumed clean, so it counts as one blocker.
every other partition kept its verdict above and below. this fault is a constraint,
so a re-run returns the same refusal — it cannot help.
fix: narrow this partition, or split it in two — the refusal on stderr names
the locus. declare the new set, then re-arrive: rhx route.guard.partition --for review --peer @all --partition '<slug>=<globs>' --mode apply"
`;

exports[`asPartitionFaultSection given: [case3] every partition refuses on the same overflow when: [t0] the section renders then: it matches snapshot 1`] = `
