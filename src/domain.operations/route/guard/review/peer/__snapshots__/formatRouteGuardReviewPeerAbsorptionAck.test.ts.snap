exports[`formatRouteGuardReviewPeerAbsorptionAck given: [case1] a CONCEDE on a lane with rounds left when: [t0] the last concern on the lane, the stone otherwise clear then: the bytes a driver reads are pinned 1`] = `
"🦉 so it is

🗿 route.stone.set --as conceded
   ├─ stone = 5.1.execution
   ├─ with  = mechanic (l1), 2 rounds, 4 budget — 2 rounds left
   ├─ about = blocker.1 — the last concern this lane owed
   │
   └─ the hold stands. fix, then re-arrive
      ├─ 1. now absorb mechanic as a whole — each of its concerns carries a stance
      │  └─ rhx route.stone.set --stone 5.1.execution --as absorbed --that mechanic
      └─ 2. re-arrive, once the fix is in
         └─ rhx route.stone.set --stone 5.1.execution --as arrived"
`;

