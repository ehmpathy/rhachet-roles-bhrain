exports[`asRouteGuardPartitionRepair given: [case1] a file in a subdir no glob lists, under a declared root when: [t0] the set is repaired then: the command matches the snapshot 1`] = `
"rhx route.guard.partition --route .behavior/v2026_01_01.demo --for review --peer @all \\
  --claim 'src/route/drive/**' --into route \\
  --mode apply"
`;

