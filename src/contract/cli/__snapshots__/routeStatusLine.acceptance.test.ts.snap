exports[`routeStatusLine.acceptance given: [case17] a cache dir that cannot be written when: [t0] the renderer runs with that cwd then: its stderr matches the snapshot: route.status.line - cache write fault 1`] = `"[route.status.line] fault: cache write failed (EEXIST) at $TEMP/.agent/.cache/…/skill=route.status.line/branch=$BRANCH.json, the line renders uncached. fix: make $TEMP/.agent/.cache/…/skill=route.status.line a writable dir (remove a file in its place, or repair its permissions)"`;

exports[`routeStatusLine.acceptance given: [case17b] a cache file that cannot be read when: [t0] the renderer runs, then runs again then: its stderr matches the snapshot: route.status.line - cache read fault 1`] = `"[route.status.line] fault: cache read failed (ELOOP) at $TEMP/.agent/.cache/…/skill=route.status.line/branch=$BRANCH.json, the line renders afresh. fix: remove $TEMP/.agent/.cache/…/skill=route.status.line/branch=$BRANCH.json, or repair its permissions"`;

exports[`routeStatusLine.acceptance given: [case17c] a passage ledger no stat can read (a malfunction) when: [t0] the renderer runs with that cwd then: the row matches the snapshot, host path masked: route.status.line - malfunction row 1`] = `"💥 MalfunctionError: [route.status.line] ELOOP: too many symbolic links encountered, stat '$TEMP/my-route/.route/passage.jsonl'"`;

