exports[`formatTokenSpendTree given: [case1] an inventory row that spans five tools when: [t0] the tree is rendered then: the render matches the snapshot 1`] = `
"🦉 the pond reflects what it was fed

🌕 reflect.on.token.spend
   ├─ transcript
   │  ├─ path = <transcript>
   │  ├─ chosen by = path
   │  ├─ calls = 4
   │  └─ rebases = 0
   │
   ├─ efficiency (measured, from message.usage)
   │  ├─ input.raw       =            10    0.6%    unpriced
   │  ├─ cache.read      =         1,000   64.5%    unpriced
   │  ├─ cache.write.5m  =           500   32.3%    unpriced
   │  ├─ cache.write.1h  =             0    0.0%       $0.00
   │  ├─ output          =            40    2.6%    unpriced
   │  ├─ total price = unpriced
   │  │  ├─ why  = no rate spec for these tokens in the installed brain packages; a rate is never guessed
   │  │  ├─ held = every token count above is measured; only the $ is absent
   │  │  └─ lift = a brain package version whose spec covers these models
   │  ├─ models = claude-demo
   │  └─ context.per-call
   │     ├─ median = 400
   │     └─ peak   = 600
   │
   ├─ inventory (context at the last call, by category)
   │  └─ tool.result              1,000  100.0%  [apportioned]
   │     ├─ Bash · git.repo.test                 710   71.0% of tool.result
   │     ├─ Read                                 160   16.0%
   │     ├─ Grep                                  60    6.0%
   │     └─ (2 more)                              70    7.0%
   │
   ├─ repaid (what each block cost, every call it stayed in context — priced per cache span)
   │  └─ (none)
   │
   └─ proposal (ranked by repaid tokens — an upper bound, not a promise)
      └─ (no target)
"
`;

