exports[`formatGuardTree given: [case17] malfunction passage — offers overrule guidance when: [t0] a reviewer malfunctioned then: output offers overrule the malfunction option 1`] = `
"🗿 route.stone.set
   ├─ stone = 1.feature
   ├─ passage = malfunction
   ├─ reason = reviewer or judge malfunctioned
   ├─ still yours to clear
   │  └─ next
   │     ├─ 1. read each given for its cause, and fix what you can
   │     ├─ 2. answer each broken lane, like a rejected one
   │     ├─ 3. re-arrive
   │     │  └─ rhx route.stone.set --stone 1.feature --as arrived
   │     └─ ask a human only for a grant you cannot make (an absent credential, a permission, etc)
   ├─ options
   │  ├─ converge with the reviewer — yours to run, and the levels above stay unlocked
   │  │  └─ rhx route.stone.set --stone 1.feature --as absorbed --that <reviewer>
   │  ├─ overrule the malfunction — a human must grant
   │  │  └─ rhx route.stone.set --stone 1.feature --as overruled
   │  ├─ or fix the reviewer, then retry
   │  └─ a broken level never halts the drive — converge the level above it
   └─ guard
      ├─ artifacts
      │   └─ 1.feature.md
      └─ reviews
          └─ r1: peer-1 (l1, 1/∞)
              ├─ malfunction 💥
              ├─ terminal — does not block higher levels
              └─ given: .route/1.feature.guard.review.i1.abc123.r1.md"
`;

