   │     ├─ 2. answer each broken lane, like a rejected one
   │     │  └─ rhx route.stone.set --stone 1.test --as absorbed --that mumbles
   │     ├─ 3. re-arrive
   │     │  └─ rhx route.stone.set --stone 1.test --as arrived
   │     └─ ask a human only for a grant you cannot make (an absent credential, a permission, etc)
   ├─ options
   │  ├─ converge with the reviewer — yours to run, and the levels above stay unlocked
   │  │  └─ rhx route.stone.set --stone 1.test --as absorbed --that <reviewer>
   │  ├─ overrule the malfunction — a human must grant
   │  │  └─ rhx route.stone.set --stone 1.test --as overruled
   │  ├─ or fix the reviewer, then retry
   │  └─ a broken level never halts the drive — converge the level above it
   └─ guard
      ├─ artifacts
      │   └─ $route/1.test*.md
      ├─ reviews
      │   └─ r1: mumbles (l1, 0/5)
      │       ├─ malfunction 💥
      │       ├─ terminal — does not block higher levels
      │       ├─ given: .reviews/peer/1.test._.review.i001.<hash>.r001._.given.by_peer.mumbles.md
      │       └─ taken: .reviews/peer/1.test._.review.i001.<hash>.r001._.taken.by_self.mumbles.md
      └─ judges
          └─ j1: echo "passed: false\\nreason: blockers found"
              ├─ finished <elapsed> ✗
              └─ reason: blockers found
