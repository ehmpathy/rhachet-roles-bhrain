exports[`education faces given: [case1] a repo with a native mechanic, on a feature branch when: [t0] each face is asked for help then: each renders as the snapshot shows: course --help 1`] = `
"🦉 tea first

📜 education.pursuit.course
   ├─ what = descend into one course of a pursuit, and return from it
   ├─ usage
   │  ├─ rhx education.pursuit.course init --course <slug>
   │  └─ rhx education.pursuit.course exit
   ├─ runs only within a pursuit; open one with rhx education.pursuit init
   ├─ a course ends only by exit, once every stone before 6.exit has passed
   ├─ examples
   │  ├─ rhx education.pursuit.course init --course idempotency
   │  └─ rhx education.pursuit.course exit
   ├─ guard verb = judge --criterion exited --route $route
   └─ exit = 0 done · 1 malfunction · 2 refused, with its fix"
`;

