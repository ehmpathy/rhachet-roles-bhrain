// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`driver.route.peer-budget-refusal.acceptance given: [case1] a grant sought with no live urgent concession when: [t0] the budget command is invoked then: stderr has good vibes: refusal — no warrant 1`] = `
"
🦉 budget refused

🗿 route.guard.budget
   ├─ route = .
   ├─ add = 2
   ├─ peer = mock-reviewer
   ├─ refused — a grant needs a live urgent concession on the last round
   │  ├─ mock-reviewer = 0/2 rounds spent — 2 left
   │  ├─ no live urgent concession stands on 1.execute
   │  └─ the route author set 2, with the whole rubric in view
   │     those 2 were the allowance for taste. past them, only harm buys a round
   │
   └─ what to do — yours to run, no human needed
      ├─ converge — a .taken per open .given, then re-arrive
      │  └─ rhx route.stone.set --stone 1.execute --as absorbed --that mock-reviewer
      └─ or grade a concern urgent, where one ships nameable harm
         ├─ urgent = security · safety · monetary · reputation · behavioral
         ├─ better = every other concern, and it earns no round
         ├─ and spend the rounds in hand first — a grant needs a reviewer that has run dry
         └─ rhx route.stone.set --stone 1.execute --as conceded \\
              --with mock-reviewer --about <concern> --severity urgent

"
`;

exports[`driver.route.peer-budget-refusal.acceptance given: [case2] a --stone prefix that resolves to several stones when: [t0] the budget command is invoked with the prefix then: stderr has good vibes: refusal — stone matched many 1`] = `
