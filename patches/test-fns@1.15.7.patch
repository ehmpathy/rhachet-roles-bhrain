+    const expiry = new Promise((_, reject) => {
+        timer = setTimeout(() => reject(new Error(`repeatably: attempt exceeded its budget of ${budgetMs - marginMs}ms`)), budgetMs - marginMs);
+    });
+    try {
+        return await Promise.race([(async () => fn())(), expiry]);
+    }
