   ├─ route = .
   ├─ add = 2
   ├─ refused — --stone matched 2 stones, and a warrant covers one
   │  ├─ 1.execute-b
   │  ├─ 1.execute
   │  └─ --stone matches a stone and every stone beneath it, so a short name reaches many
   │
   └─ what to do — yours to run, no human needed
      └─ name the one stone you meant, in full
         ├─ rhx route.guard.budget --for review --add 2 --stone 1.execute-b
         └─ rhx route.guard.budget --for review --add 2 --stone 1.execute

"
`;

