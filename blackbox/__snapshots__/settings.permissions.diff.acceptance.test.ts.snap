exports[`settings.permissions.diff.acceptance given: [case3] a regen that reorders every list and narrows one entry when: [t0] the committed rev is compared with the work tree then: the report matches its snapshot 1`] = `
"🦉 the pond reflects what moved, not how it was stirred

🔍 settings.permissions.diff
   ├─ of = settings.json
   ├─ from = HEAD
   ├─ into = (work tree)
   ├─ allow
   │  ├─ added = 0
   │  └─ removed = 1
   │     └─ - Write(.route/**)
   ├─ deny
   │  ├─ added = 1
   │  │  └─ + Edit(.route/**)
   │  └─ removed = 0
   ├─ ask
   │  ├─ added = 0
   │  └─ removed = 0
   └─ all else equal = true
"
`;

exports[`settings.permissions.diff.acceptance given: [case3] a regen that reorders every list and narrows one entry when: [t1] a rev that lacks the file is named then: the fault matches its snapshot 1`] = `
"💥 MalfunctionError: cannot read absent.json at HEAD
   └─ cause: path 'absent.json' does not exist in 'HEAD'
"
`;

exports[`settings.permissions.diff.acceptance given: [case4] a regen that widens one entry and changes a hook when: [t0] the committed rev is compared with the work tree then: the report matches its snapshot 1`] = `
"🦉 the pond reflects what moved, not how it was stirred

🔍 settings.permissions.diff
   ├─ of = settings.json
   ├─ from = HEAD
   ├─ into = (work tree)
   ├─ allow
   │  ├─ added = 2
   │  │  ├─ + Bash(rm:*)
   │  │  └─ + Bash(curl:*)
   │  └─ removed = 0
   ├─ deny
   │  ├─ added = 0
   │  └─ removed = 1
   │     └─ - Bash(rm:*)
   ├─ ask
   │  ├─ added = 0
   │  └─ removed = 0
   └─ all else equal = false
      └─ ~ hooks
"
`;

