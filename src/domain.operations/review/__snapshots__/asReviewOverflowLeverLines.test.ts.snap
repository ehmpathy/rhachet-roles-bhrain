// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`asReviewOverflowLeverLines given: [case1] an overflow led by added files when: [t0] the lever is chosen then: the lines match the snapshot 1`] = `
"   ├─ lever — partition what the rubric grades, cut what it does not
   │  ├─ --partition 'review=src/domain.operations/review/**,.behavior/v2026_10_04.feat/**'
   │  ├─ --partition 'cli=src/contract/cli/**,.behavior/v2026_10_04.feat/**'
   │  ├─ (+ 1 more group — every target must sit in a partition)
   │  ├─ one domain per partition, with its own tests (rule.forbid.horizontal-partitions)
   │  ├─ list the shared context in every partition that reads it too — route yields, briefs, shared types
   │  │  └─ the overlap is graded once, and it leads each prompt, so every partition reads it from cache
   │  ├─ preview first with --mode plan (under a guard, rhx route.guard.partition --for review --peer @all)
   │  └─ or cut a subtree the rubric does not grade — --paths-wout '<subtree>/**'"
`;

