+ * .note = patched into test-fns@1.15.7 by rhachet-roles-bhrain; see ehmpathy/test-fns#71
+ */
+const runAttemptWithinBudget = async (fn) => {
+    const budgetMs = globalThis[Symbol.for('TEST_TIMEOUT_SYMBOL')];
+    const marginMs = 1000;
+    if (typeof budgetMs !== 'number' || budgetMs <= marginMs * 2)
+        return await fn();
