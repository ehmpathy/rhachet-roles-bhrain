🔍 route.status.line.show
   ├─ via = rhachet-roles-bhrain/cli/route.status.line
   ├─ cwd = <seat>
   ├─ cold = true
   ├─ cache = miss
   ├─ cpu = <cpu>s
   ├─ exit = 0
   ├─ stdout = (blank line)
   └─ stderr = (none)
"
`;

exports[`route.status.line.show.integration given: [case6] an unbound seat, repainted cold and then warm when: [t1] the warm repaint runs over the cache the cold one wrote then: the warm repaint renders as its snapshot, volatile bytes masked 1`] = `
