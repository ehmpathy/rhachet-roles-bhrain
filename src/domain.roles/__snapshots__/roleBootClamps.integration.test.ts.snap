exports[`roleBootClamps given: [case3] the librarian role boot when: [t5] the real \`rhachet roles cost --all\` costs it then: its row reads owned, under its declared budget 1`] = `"<n> / <n> tokens (<n>%)  src/domain.roles/librarian/boot.yml"`;

exports[`roleBootClamps given: [case4] a boot spec over its budget when: [t0] the real \`rhachet roles boot\` boots it then: the halt tree matches the snapshot 1`] = `
"🧢 roles boot --what <fixture>/boot.yml
   ├─ ✋ ConstraintError: over budget
   │  ├─ budget   = 10 tokens   (declared in boot.yml)
   │  ├─ payload  = <n> tokens   (full emitted payload, o200k_base)
   │  └─ over by  = <n> tokens   (<p>% of budget)
   │
   ├─ some resources must go — you choose which
   │  └─ rhx cost --what <fixture>/boot.yml   sorts every batch by what it costs
   │
   └─ fix — four strategies, cheapest first
      ├─ catalogize  replace a set with one catalog that indexes it
      ├─ condense    author an x.md.min beside x.md
      ├─ reference   move a say entry to ref (it stays addressable, costs its path line)
      └─ eliminate   list what does not earn its boot under \`not\` (the file stays)"
`;

exports[`roleBootClamps given: [case5] a boot spec whose payload equals its budget exactly when: [t0] the real \`rhachet roles boot\` boots it then: the stats block shape matches the snapshot 1`] = `
"quant
  ├── files = <n>
  │   ├── briefs = <n>
  │   └── skills = <n>
  ├── tokens = <n> (full emitted payload, o200k_base)
  └── budget = <n> / <n> tokens (<n>% used)"
`;

exports[`roleBootClamps given: [case6] a linked seat whose role is over its budget when: [t0] the seat boots the linked role then: the warn the seat sees matches the snapshot 1`] = `
"🧢 roles boot --what .agent/repo=probe/role=probe/boot.yml
   ├─ 🟡 over budget — and this spec is not yours to trim
   │  ├─ budget   = 10 tokens   (declared upstream)
   │  ├─ payload  = <n> tokens   (full emitted payload, o200k_base)
   │  └─ over by  = <n> tokens   (<p>% of budget)
   │
   └─ not refused — the spec is a symlink into a version-pinned store,
      so every remedy would name a file this repo cannot write"
`;
