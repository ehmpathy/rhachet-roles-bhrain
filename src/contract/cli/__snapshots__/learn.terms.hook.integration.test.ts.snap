exports[`learn.terms.hook.integration given: [case7] a bad verb when: [t0] an unknown verb, no verb, two verbs, and --help run then: the outputs match the snapshot: help 1`] = `
"🦉 tend the terms

📜 learn.terms.hook
   ├─ what = turn the learner's onStop term hook on or off for this repo
   ├─ usage = rhx learn.terms.hook <verb>
   ├─ verbs
   │  ├─ get      report whether the term hook is on in this repo
   │  ├─ enable   add the onStop term hook
   │  └─ disable  remove it
   ├─ default = disabled; no repo pays for the hook until it asks
   ├─ effect when on = a session's stop is held until it distills its terms; a fresh distill quiets it for 60 min
   ├─ examples
   │  ├─ rhx learn.terms.hook get       # is it on here?
   │  └─ rhx learn.terms.hook enable    # turn it on, then commit the file it names
   ├─ exit = 0 done · 1 malfunction · 2 refused, with its fix
   └─ cleanup after the learner is unlinked
      ├─ relink the learner, then rhx learn.terms.hook disable
      └─ or delete the one Stop entry by toggle=learn.terms.hook/role=learner
"
`;

