exports[`route.status.line.show.integration given: [case7] a repaint where node cannot find the package when: [t0] the repaint runs then: the fault renders as its snapshot, host bytes masked 1`] = `
"🦉 one repaint, as a seat sees it

🔍 route.status.line.show
   ├─ via = rhachet-roles-bhrain/cli/route.status.line
   ├─ cwd = <seat>
   ├─ cold = false
   ├─ cache = (not reached)
   ├─ cpu = <cpu>s
   ├─ exit = 1
   ├─ stdout = (none)
   └─ stderr
      ├─
      │
      │  Error [ERR_MODULE_NOT_FOUND]: Cannot find package '<path>' imported from <seat>
      │
      └─"
`;

