   │     ├─ ~130,000 tokens   2 files  src/b/meter
   │     └─  ~50,000 tokens    1 file  src/b/cache
   ├─ fix: narrow that partition, or split it in two — the tool never splits a partition again
   └─ redeclare the set with narrower --partition flags (under a guard, rhx route.guard.partition --for review --peer @all)"
`;

exports[`asReviewPartitionRefusal given: [case5] a route set that leaves the prime files unclaimed (the i008 refusal) when: [t0] the refusal is checked with the route set it came from then: the lines match the snapshot 1`] = `
"   ├─ unclaimed → where the repair places each
   │  ├─ src/domain.operations/review/prime/setOnePrime.ts → review-ops (+ src/domain.operations/review/prime/**)
   │  └─ src/domain.operations/review/prime/setOnePrime.test.ts → review-ops (+ src/domain.operations/review/prime/**)
   └─ repair — run this to claim each gap into its partition
      └─ rhx route.guard.partition --route .behavior/v2026_01_01.demo --for review --peer @all \\
           --claim 'src/domain.operations/review/prime/**' --into review-ops \\
           --mode apply

