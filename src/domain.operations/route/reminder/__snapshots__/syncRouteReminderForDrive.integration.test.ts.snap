// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`syncRouteReminderForDrive.integration given: [case5] a live drive whose spawn returns a DEAD pid (a systematic boot failure) when: [t0] the drive syncs twice against the dead-pid spawn then: each drive surfaces the crash to the log and leaves no live handle 1`] = `"RouteReminder auto-sync fault (drive proceeds — continuity may be degraded): RouteReminder daemon (pid <pid>) died on arrival — the spawn crashed before its first tick"`;

exports[`syncRouteReminderForDrive.integration given: [case7] a live drive whose spawn SYSTEMATICALLY crashes on arrival (a broken host) when: [t0] the drive syncs repeatedly against the crash spawn then: the clone log names the trip, the cutoff, and the re-arm 1`] = `"RouteReminder auto-sync fault (drive proceeds — continuity may be degraded): RouteReminder auto-respawn tripped: 6 consecutive crash-on-arrivals exceeded the 5 cutoff — auto-respawn halts for this clone until a manual route.reminder.gen re-arms it"`;

exports[`syncRouteReminderForDrive.integration given: [case10] a live drive with no daemon, whose focus write faults when: [t0] the drive syncs the reminder then: the focus fault line is surfaced, with why the daemon was reaped 1`] = `"RouteReminder auto-sync fault (drive proceeds — continuity may be degraded): RouteReminder focus write faulted — the daemon is reaped so it cannot nudge about a route this clone left: ENOTDIR: not a directory, open '<route>/.agent/.cache/repo=bhrain/role=driver/skill=route.reminder/daemon.of=reminder-driveon.session=~40~3aclone-focus-fault-1.focus' [also: reminder-log write faulted: ENOTDIR: not a directory, mkdir '<route>/.agent/.cache/repo=bhrain/role=driver/skill=route.reminder']"`;

exports[`syncRouteReminderForDrive.integration given: [case13] a live drive whose focus is gone by the time the fresh daemon boots when: [t0] the drive syncs and the spawn clears the focus first then: the clone log names the absent focus, not a crash 1`] = `"RouteReminder auto-sync fault (drive proceeds — continuity may be degraded): RouteReminder daemon (pid <pid>) exited at boot — the clone focus was absent, so it had no route to nudge about; the next drive writes the focus and registers afresh"`;
