// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`getLearnerRole given: [case1] the built learner role when: [t0] its onTool hooks are inspected then: the hook runs the linked skill file directly, anchored on the project dir 1`] = `"d="\${CLAUDE_PROJECT_DIR:-.}"; r="$d/.agent/repo=bhrain"; s="$r/role=learner/skills"; f="$s/memory.guard.sh"; [ -f "$f" ] && { e="$(MEMORY_GUARD_HOOK_EXIT_ALLOW=20 MEMORY_GUARD_HOOK_EXIT_FAULT=21 MEMORY_GUARD_HOOK_EXIT_BLOCK=22 bash "$f" --mode hook 2>&1 >/dev/null)"; c=$?; case "$c" in 20|21|22) [ -n "$e" ] && printf "%s\\n" "$e" >&2; exit $((c - 20));; esac; echo "📜 memory.guard: could not run (skill ended with exit $c, short of a sealed code, at $f); call allowed. fix: reinstall rhachet-roles-bhrain" >&2; [ -n "$e" ] && printf "%s\\n" "$e" >&2; exit 1; }; { [ -L "$r" ] || [ -L "$r/role=learner" ] || [ -L "$s" ] || [ -L "$f" ]; } && { echo "📜 memory.guard: could not run (skill link dangles at $f); call allowed. fix: reinstall rhachet-roles-bhrain, then ./node_modules/.bin/rhachet roles link --repo bhrain --role learner" >&2; exit 1; }; echo "📜 memory.guard: could not run (skill not linked under $d); call allowed. fix: ./node_modules/.bin/rhachet roles link --repo bhrain --role learner" >&2; exit 1"`;
