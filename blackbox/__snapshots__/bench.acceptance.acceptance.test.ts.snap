// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`bench.acceptance.acceptance given: [case1] a human who asks the bench to explain itself when: [t0] --help is passed then: the usage renders whole 1`] = `
"
🦉 bench.acceptance — measure the acceptance suite honestly

  usage:
    bench.acceptance.js run     --label <name> [--no-build] [--workers N] [--scope <regex>]
    bench.acceptance.js gate    --label <name>
    bench.acceptance.js report  --label <name>
    bench.acceptance.js compare --before <name> --after <name>

  commands:
    run       build (timed) + jest (timed, --json) -> phases, per-file cost, per-case verdicts
    gate      time the paved \`npm run test:acceptance\` end to end — THE bar, no instrument
    report    print a recorded run as a tree
    compare   diff two runs: wall clock delta + any case that PASSED before and does not now

  options:
    --label     name this measurement                      (required for run/gate/report)
    --no-build  skip the build phase, reuse extant dist/   (default: build)
    --workers   jest maxWorkers override                   (default: config, = 1)
    --scope     jest testPathPattern regex                 (default: all)

  artifacts:
    .log/bench.acceptance/<label>.json

"
`;

exports[`bench.acceptance.acceptance given: [case2] a command the bench does not know when: [t0] the bench is run then: the refusal renders whole 1`] = `
"🦉 unknown command "bogus"
"
`;

exports[`bench.acceptance.acceptance given: [case3] a report of a label never recorded when: [t0] the bench is run then: the refusal renders whole 1`] = `
"🦉 no run recorded at $CWD/.log/bench.acceptance/never.json
   fix: bench.acceptance.js run --label never
"
`;

exports[`bench.acceptance.acceptance given: [case4] two recorded runs where every case still passes when: [t0] the runs are compared then: the verdict renders whole 1`] = `
"
🦉 bench.acceptance compare
   ├─ before  before  5m00s
   ├─ after   after  3m20s
   └─ delta   1m40s faster  (1.50x)

✅ no regression — all 1 cases that passed before still pass

"
`;

exports[`bench.acceptance.acceptance given: [case5] two recorded runs where a case that passed no longer does when: [t0] the runs are compared then: the regression renders whole, lost and weaker cases named 1`] = `
"
🦉 bench.acceptance compare
   ├─ before  before  5m00s
   ├─ after   after  3m20s
   └─ delta   1m40s faster  (1.50x)

⛈️  REGRESSION
   ├─ 1 case(s) PASSED before and are now ABSENT
   │  └─ a > c
   └─ 1 case(s) PASSED before and no longer pass
      └─ a > b  [failed]

"
`;
