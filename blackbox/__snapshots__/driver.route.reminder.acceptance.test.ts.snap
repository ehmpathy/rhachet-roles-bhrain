// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`driver.route.reminder.acceptance given: [case1] a fresh route with no reminder set when: [t0] route.reminder.get runs via the real skill wrapper then: the get stdout matches the shell snapshot a human reads 1`] = `
"reminder is not live — no daemon was ever registered for this session; register one with route.reminder.gen (or it auto-registers on the next route.drive while the route is a live drive)
"
`;

exports[`driver.route.reminder.acceptance given: [case1] a fresh route with no reminder set when: [t1] route.reminder.del runs via the real skill wrapper then: the del stdout matches the shell snapshot a human reads 1`] = `
"reminder was not live (no live daemon to stop)
"
`;

exports[`driver.route.reminder.acceptance given: [case2] a human asks the gen skill for help when: [t0] route.reminder.gen --help runs via the real skill wrapper then: the full --help usage block matches its snapshot 1`] = `
"route.reminder — manage a driver session RouteReminder daemon

commands:
  gen     register (findsert) the daemon; spawns one if absent
  get     report whether the reminder is live, and its pid
  del     deregister — stop the daemon and clear the handle
  daemon  the detached loop a register spawns (not called by hand)

flags:
  --route <path>         the route dir            (default: the bound route)
  --clone-addr <addr>    the driver clone addr    (default: this session addr)
  --interval-ms <n>      cadence in ms            (default: 1200000 = 20m)
  --say-timeout-ms <n>   inject-call bound in ms  (default: 30000 = 30s)

note:
  gen/get/del derive both flags on their own when run inside a bound,
  enrolled session: --route defaults to the branch bound route (rhx
  route.bind.set), --clone-addr defaults to this session own addr
  (RHACHET_CLONE_SERIAL). pass either flag to override — e.g. to inspect a
  DIFFERENT route or session.

  --clone-addr takes the SAME "@:"-prefixed address \`rhx clone say\` and
  \`rhx clone whoami\` use — e.g. \`@:<serial>\` (the serial from
  $RHACHET_CLONE_SERIAL / \`rhx clone whoami\`), or \`@:<slug>\` for a named
  clone. one address form everywhere — no bare-serial variant is accepted.

example:
  route.reminder.get                       (inside a bound, enrolled session)
  route.reminder.gen --route .behavior/my-feature --clone-addr @:driver-1
"
`;

exports[`driver.route.reminder.acceptance given: [case3] a blocked route (the daemon must self-exit at once, no live clone) when: [t0] route.reminder.daemon runs the real loop against the blocked route then: the daemon self-exit stdout matches its shell snapshot 1`] = `
"route.reminder.daemon exited: reason=route-not-live ticks=1 route=. clone=@:driver-1
"
`;

exports[`driver.route.reminder.acceptance given: [case4] a fresh blocked route — gen drives the REAL detached-spawn path when: [t0] route.reminder.gen runs the real register path then: the real gen-spawn stdout matches its shell snapshot 1`] = `
"reminder daemon spawned (pid <pid>) but the route is not a live drive (route-not-live) — it self-exits on arrival; daemon log: <tmpdir>
"
`;

exports[`driver.route.reminder.acceptance given: [case5] the AUTO-WIRE — route.drive findserts the reminder on a live drive when: [t0] route.drive runs in an enrolled env against a live route then: route.drive still surfaces its stone guidance 1`] = `
"🦉 where were we?

🗿 route.drive
   ├─ where do we go?
   │  ├─ route = .
   │  └─ stone = 2.criteria
   │
   ├─ are you here?
   │  ├─ when ready for review, run:
   │  │  └─ rhx route.stone.set --stone 2.criteria --as arrived
   │  └─ when ready to continue, run:
   │     └─ rhx route.stone.set --stone 2.criteria --as passed
   │
   ├─ here's the stone
   │  ├─
   │  │
   │  │  # 2.criteria
   │  │
   │  │  define the acceptance criteria
   │  │
   │  │  specify:
   │  │  - the inputs
   │  │  - the outputs
   │  │  - the edge cases
   │  │
   │  └─
   │
   └─ are you here?
      ├─ when ready for review, run:
      │  └─ rhx route.stone.set --stone 2.criteria --as arrived
      └─ when ready to continue, run:
         └─ rhx route.stone.set --stone 2.criteria --as passed
"
`;

exports[`driver.route.reminder.acceptance given: [case6] a COMPLETED route (every stone passed — the daemon self-exits route-complete) when: [t0] route.reminder.daemon runs the real loop against the completed route then: the completed-route self-exit stdout matches its snapshot 1`] = `
"route.reminder.daemon exited: reason=route-complete ticks=1 route=. clone=@:driver-1
"
`;

exports[`driver.route.reminder.acceptance given: [case7] a live drive but an unreachable clone (dead session — the daemon self-exits session-dead) when: [t0] route.reminder.daemon runs the real loop, reaches the bogus clone, and fails reach-state then: the dead-session self-exit stdout matches its snapshot 1`] = `
"route.reminder.daemon exited: reason=session-dead ticks=1 route=. clone=@:driver-1
"
`;

exports[`driver.route.reminder.acceptance given: [case8] a session whose handle already names a live daemon (findsert hit) when: [t0] route.reminder.gen runs against the already-live session then: the findsert-hit stdout matches its shell snapshot 1`] = `
"reminder already live — daemon pid <pid> (no duplicate spawned)
"
`;

exports[`driver.route.reminder.acceptance given: [case9] a session whose handle names a genuinely live daemon (deregister) when: [t0] route.reminder.del runs against the live daemon then: the deregister-success stdout matches its shell snapshot 1`] = `
"reminder deregistered — live daemon stopped, handle cleared
"
`;

exports[`driver.route.reminder.acceptance given: [case10] a session whose handle names a genuinely live daemon (detect) when: [t0] route.reminder.get runs against the live session then: the live-detect stdout matches its shell snapshot 1`] = `
"reminder is live — daemon pid <pid>
"
`;

exports[`driver.route.reminder.acceptance given: [case13] a session whose auto-respawn breaker has tripped (circuit-broken) when: [t0] route.reminder.get runs against the circuit-broken session then: the circuit-broken stdout matches its shell snapshot 1`] = `
"reminder is not live — auto-respawn is CIRCUIT-BROKEN after 6 consecutive crash-on-arrivals (the spawn keeps dying on boot); the drive will NOT re-spawn it until you re-arm. fix: repair the spawn, then run route.reminder.gen. crash history: <tmpdir>
"
`;
