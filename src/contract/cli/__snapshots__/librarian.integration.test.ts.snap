exports[`librarian.integration given: [case5] --help when: [t0] brief.min.moveout runs with --help then: the help matches snapshot (aesthetic review) 1`] = `
"🦉 brief.min.moveout — move the .why sections of a set of mins out to the .md beside each

📚 brief.min.moveout --help
   ├─ usage: rhx brief.min.moveout --glob <glob> [--mode <mode>]
   ├─ flags
   │  ├─ --glob  a set of \`.md.min\` files; repeat it to union several sets
   │  └─ --mode  plan (default) lists each section; apply rewrites each min
   └─ exit: 0 on success · 2 on bad input (no --glob, an unknown flag, or a glob that names no file)
"
`;
