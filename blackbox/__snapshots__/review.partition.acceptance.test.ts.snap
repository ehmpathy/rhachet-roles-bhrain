exports[`review.partition.acceptance given: [case2] a target that sits in no partition when: [t0] the review is invoked then: the refusal renders as the driver reads it 1`] = `
"
🦉 woah there

✋ ConstraintError: 1 target sits in no partition, so a split would leave targets unreviewed
   ├─ unclaimed → where the repair places each
   │  └─ src/dirty.ts → clean (+ src/{,__snapshots__/}dirty.*)
   └─ repair — re-run with these --partition flags beside yours
      └─   --partition 'clean=src/{,__snapshots__/}dirty.*'

✨ did you know?
   ├─ claim each domain whole, in every layer, and the files you edit next stay covered
   └─ e.g. src/route/** and blackbox/{,__snapshots__/}driver.route.* in one partition

"
`;

