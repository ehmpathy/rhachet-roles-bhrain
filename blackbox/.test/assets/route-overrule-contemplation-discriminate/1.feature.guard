artifacts:
  - $route/1.feature*.md

reviews:
  peer:
    # level 1: basic checker, rejects by default; a preemptive overrule waves it
    - slug: basic-checker
      run: bash $route/.test/mock-review-l1.sh
      budget: 5
      level: 1

    # level 3: premium checker, rejects by default; its blockers sit within the
    # judge budget below, so the reviewed? judge PASSES l3 on the tally — which
    # lets the contemplation gate (not the judge) become the blocker
    - slug: premium-checker
      run: bash $route/.test/mock-review-l3.sh
      budget: 5
      level: 3

# allow-blockers 9: the reviewed? judge tolerates l3's blockers, so
# allJudgesPassed is true and the contemplation gate is what holds passage.
# this is the seam that discriminates "held by the judge" from "held by the
# contemplation gate" (R6).
judges:
  - rhx route.stone.judge --mechanism reviewed? --stone $stone --route $route --allow-blockers 9
