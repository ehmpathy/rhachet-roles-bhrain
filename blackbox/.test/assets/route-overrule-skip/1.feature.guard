artifacts:
  - $route/1.feature*.md

reviews:
  peer:
    # level 1: basic checker, rejects by default; overrule waves it
    - slug: basic-checker
      run: bash $route/.test/mock-review-l1.sh
      budget: 5
      level: 1

    # level 3: premium checker, rejects by default, passes via flag
    # this is the guard that MUST still fire after l1 is overruled
    - slug: premium-checker
      run: bash $route/.test/mock-review-l3.sh
      budget: 5
      level: 3

judges:
  - rhx route.stone.judge --mechanism reviewed? --stone $stone --route $route --allow-blockers 0
