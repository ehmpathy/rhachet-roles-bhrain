exports[`driver.route.partition-journey.acceptance given: [case1] a guarded stone whose lane overflows (arc A) then: stdout matches snapshot 1`] = `
"🦉 the way speaks for itself

🦉 the partitions would leave changed files unreviewed — no lane runs until they cover them

🗿 route.guard.partition, on stone 1.execute
   └─ scope @all
      ├─ 1 changed file sits in no partition
      │  └─ src/gamma/getGamma.ts → gamma (+ src/gamma/**)
      └─ repair — run this, then re-arrive
            rhx route.guard.partition --route .behavior/v2026_01_01.demo --for review --peer @all \\
              --partition 'alpha=src/alpha/**,.behavior/v2026_01_01.demo/**' \\
              --partition 'beta=src/beta/**,.behavior/v2026_01_01.demo/**' \\
              --partition 'gamma=src/gamma/**,.behavior/v2026_01_01.demo/**' \\
              --mode apply

✨ did you know?
   ├─ claim each domain whole, in every layer, and the files you edit next stay covered
   └─ e.g. src/route/** and blackbox/{,__snapshots__/}driver.route.* in one partition
"
`;

