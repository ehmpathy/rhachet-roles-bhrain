exports[`gen.consumer-patch.integration given: [case10] a local build that differs from the published base when: [t0] the skill writes the patch then: the success tree matches its snapshot 1`] = `
"🦉 a path for those who cannot wait

🔍 gen.consumer-patch
   ├─ base = rhachet-roles-bhrain@0.42.1
   ├─ files = 2
   ├─ verified = applies cleanly to the base
   ├─ patch = out.patch
   └─ for the consumer, in order
      ├─ 1. copy it to patches/rhachet-roles-bhrain@0.42.1.patch
      ├─ 2. name it in package.json pnpm.patchedDependencies
      │  └─ "rhachet-roles-bhrain@0.42.1": "patches/rhachet-roles-bhrain@0.42.1.patch"
      ├─ 3. pnpm install
      └─ 4. re-run the inits, so each seat's settings name the new code
         ├─ npx rhachet roles init --repo bhrain --role driver
         └─ every changed asset rides in the patch
"
`;

exports[`gen.consumer-patch.integration given: [case10b] a local build that changed a role asset when: [t0] the skill writes the patch then: the success tree matches its snapshot 1`] = `
"🦉 a path for those who cannot wait

🔍 gen.consumer-patch
   ├─ base = rhachet-roles-bhrain@0.42.1
   ├─ files = 2
   ├─ verified = applies cleanly to the base
   ├─ patch = out.patch
   ├─ left out, role assets a consumer's host holds read-only, which pnpm cannot patch
   │  └─ dist/domain.roles/driver/inits/init.claude.status-line.jsonc
   │
   └─ for the consumer, in order
      ├─ 1. copy it to patches/rhachet-roles-bhrain@0.42.1.patch
      ├─ 2. name it in package.json pnpm.patchedDependencies
      │  └─ "rhachet-roles-bhrain@0.42.1": "patches/rhachet-roles-bhrain@0.42.1.patch"
      ├─ 3. pnpm install
      └─ 4. re-run the inits, so each seat's settings name the new code
         ├─ npx rhachet roles init --repo bhrain --role driver
         └─ an init reads the assets left out above in their old form, until the release
"
`;

