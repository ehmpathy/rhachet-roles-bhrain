 else
-  nohup "$CHROMIUM_BIN" "${CHROME_FLAGS[@]}" > /dev/null 2>&1 &
+  # .why = a headful chrome on a virtual display (no desktop session) hits the same sandbox abort as headless
+  nohup "$CHROMIUM_BIN" "${HEADLESS_FLAGS[@]}" "${CHROME_FLAGS[@]}" > /dev/null 2>&1 &
 fi
 
